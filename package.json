{
  "name": "worlds",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WORLDS_DEV=1 bun --watch server/index.ts",
    "start": "bun server/index.ts",
    "test": "bun test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build:docs": "bun scripts/build-docs.ts",
    "build:sdk": "bun build sdk/src/index.ts --outfile sdk/worlds.js --format iife --banner \"/* worlds.js v1 — GENERATED from sdk/src/ by 'bun run build:sdk'. Do not edit by hand. */\"",
    "cli:build": "bun build --compile cli/worlds.ts --outfile bin/worlds",
    "check:sites": "node scripts/check-sites.mjs"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "5"
  },
  "dependencies": {
    "yjs": "^13.6.32"
  }
}
